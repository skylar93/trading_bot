# Python related
**pycache**/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Virtual environment
venv/
.venv/

# Logs and data
logs/
*.log
data/
# Week 61: DataSource abstraction code lives in data/sources/ — track as code
!data/__init__.py
!data/sources/
!data/sources/**
# Week 62: data quality code
!data/quality/
!data/quality/**
# Week 79 (H8): DVC-tracked directories (gitkeep markers only — actual data ignored)
!data/raw/
!data/raw/.gitkeep
!data/processed/
!data/processed/.gitkeep
# tests/data/ is test code, not data — always track
!tests/data/
!tests/data/**
# ...but still ignore bytecode caches inside tests/data/
tests/data/__pycache__/

